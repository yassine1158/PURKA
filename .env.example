# Copiez ce fichier en .env (ou définissez ces variables dans le service Windows)
PORT=3000
HOST=0.0.0.0
# Dossier des données (base + photos). À sauvegarder chaque jour.
DATA_DIR=./data
# HTTPS direct (sinon passez par un reverse proxy comme Caddy et mettez TRUST_PROXY=true + COOKIE_SECURE=true)
# HTTPS_KEY=C:\evia\certs\key.pem
# HTTPS_CERT=C:\evia\certs\cert.pem
# COOKIE_SECURE=true
# TRUST_PROXY=true
# Session : déconnexion après 12 h sans activité, et au plus tard après 7 jours
SESSION_IDLE_HOURS=12
SESSION_MAX_DAYS=7
