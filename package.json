{
  "name": "evia-reception",
  "version": "1.0.0",
  "description": "Réception matières premières Évia : bascule, contrôle qualité, stock, achats et paiements, avec droits par rôle.",
  "main": "src/server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning src/server.js",
    "dev": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning --watch src/server.js",
    "create-admin": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning scripts/create-admin.js",
    "backup": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning scripts/backup.js",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.js"
  },
  "dependencies": {
    "express": "5.3.0",
    "express-rate-limit": "7.5.1",
    "helmet": "8.3.0",
    "multer": "2.5.0"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "license": "UNLICENSED"
}
